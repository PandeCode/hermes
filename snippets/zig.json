{
    "io": {
        "prefix": "io",
        "body": [
            "var threaded: std.Io.Threaded = .init_single_threaded;",
            "const io = threaded.io();"
        ],
        "description": "get an io"
    },
    "rand": {
        "prefix": "rand",
        "body": [
            "const seed = @truncate(u64, @bitCast(u128, std.time.nanoTimestamp()));",
            "var prng = std.rand.DefaultPrng.init(seed);"
        ],
        "description": "get a rand"
    },
    "stdin": {
        "prefix": "stdin",
        "description": "stdin",
        "body": [
            "var stdin_buffer: [1024]u8 = undefined;",
            "var stdin_reader = std.Io.File.stdin().reader(init.io, &stdin_buffer);",
            "const stdin = &stdin_reader.interface;"
        ]
    },
    "stdout": {
        "prefix": "stdout",
        "description": "stdout",
        "body": [
            "var stdout_buffer: [1024]u8 = undefined;",
            "var stdout_writer = std.Io.File.stdout().writer(init.io, &stdout_buffer);",
            "const stdout = &stdout_writer.interface;"
        ]
    },
    "panic": {
        "prefix": "panic",
        "description": "zig custom panic",
        "body": [
            "pub const panic = std.debug.FullPanic(struct {",
            "    extern",
            "    pub fn crashed(msg: []const u8, trace: ?usize) noreturn {",
            "        var buf: [",
            "                        4098",
            "                    ]u8 = undefined;",
            "        const s = std.fmt.bufPrintSentinel(&buf,",
            "                    \"zenity --error --text '{s}'\", .{msg",
            "                    },",
            "                    0) catch",
            "            std.debug.defaultPanic(msg, trace);",
            "",
            "        _ = c_std.system(s.ptr);",
            "        std.debug.defaultPanic(msg, trace);",
            "                }",
            "            }.crashed);",
            "        ]",
            "    }",
            "}"
        ]
    }
}
