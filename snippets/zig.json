{
    "fetch": {
        "prefix": "fetch",
        "body": [
            "var body: std.Io.Writer.Allocating = .init(gpa);",
            "defer body.deinit();",
            "const fetch_res = try client.fetch(.{",
            "    .location = .{ .url = url },",
            "    .method = .GET,",
            "    .response_writer = &body.writer,",
            "});",
            "if (fetch_res.status != .ok) {",
            "    return error.ReqFail;",
            "}",
            "const res_body = try body.toOwnedSlice();"
        ],
        "description": "fetch"
    },
    "translate c": {
        "prefix": "translate",
        "body": [
            "const ${1:somelib} = b.addTranslateC(.{",
            "    .root_source_file = blk: {",
            "        const wf = b.addWriteFiles();",
            "        const wf_path = wf.add(\"c_${1:somelib}.h\",",
            "            // c",
            "            \\\\\\\\#include \"${2:somelib.h}\"",
            "        );",
            "        break :blk wf_path;",
            "    },",
            "    .optimize = optimize,",
            "    .target = target,",
            "});",
            "exe_mod.addImport(\"${3:c}\", ${1:somelib}.createModule());",
            "exe_mod.linkSystemLibrary(\"${1:somelib}\", .{});"
        ],
        "description": "translate c"
    },
    "run": {
        "prefix": "std.process.run",
        "body": [
            "const run_result = try std.process.run(gpa, io, .{ .argv = &.{} });",
            "defer gpa.free(run_result.stderr);",
            "defer gpa.free(run_result.stdout);",
            "if (run_result.term != .exited) return error.Failed;"
        ],
        "description": "run a process and free"
    },
    "io": {
        "prefix": "io",
        "body": [
            "var threaded: std.Io.Threaded = .init_single_threaded;",
            "const io = threaded.io();"
        ],
        "description": "get an io"
    },
    "rand": {
        "prefix": "rand",
        "body": [
            "var seed: u64 = undefined;",
            "io.random(std.mem.asBytes(&seed));",
            "var prng: std.Random.DefaultPrng = .init(seed);",
            "const rand = prng.random();"
        ],
        "description": "get a rand"
    },
    "stdin": {
        "prefix": "stdin",
        "description": "stdin",
        "body": [
            "var stdin_buffer: [1024]u8 = undefined;",
            "var stdin_reader = std.Io.File.stdin().reader(init.io, &stdin_buffer);",
            "const stdin = &stdin_reader.interface;"
        ]
    },
    "stdout": {
        "prefix": "stdout",
        "description": "stdout",
        "body": [
            "var stdout_buffer: [1024]u8 = undefined;",
            "var stdout_writer = std.Io.File.stdout().writer(init.io, &stdout_buffer);",
            "const stdout = &stdout_writer.interface;",
            "defer stdout.flush() catch {};"
        ]
    },
    "panic": {
        "prefix": "panic",
        "description": "zig custom panic",
        "body": [
            "pub const panic = std.debug.FullPanic(struct {",
            "    extern \"c\" fn system(command: [*:0]const u8) c_int;",
            "",
            "    fn crashed(msg: []const u8, first_trace_addr: ?usize) noreturn {",
            "        var buf: [4096]u8 = undefined;",
            "        if (std.fmt.bufPrintSentinel(&buf, \"zenity --error --text '{s}'\", .{msg}, 0)) |cmd| {",
            "            _ = system(cmd.ptr);",
            "        } else |_| {}",
            "        std.debug.defaultPanic(msg, first_trace_addr);",
            "    }",
            "}.crashed);"
        ]
    },
    "main": {
        "prefix": "main",
        "body": [
            "pub fn main(init: std.process.Init) !void {",
            "    const gpa = init.gpa;",
            "    const io = init.io;",
            "    const arena = init.arena.allocator();",
            "    const args = try init.minimal.args.toSlice(arena);",
            "    _ = .{ gpa, io, args };",
            "    $0",
            "}"
        ],
        "description": "main with gpa, io, arena and args"
    },
    "test": {
        "prefix": "test",
        "body": [
            "test \"${1:name}\" {",
            "    const gpa = std.testing.allocator;",
            "    _ = gpa;",
            "    try std.testing.expectEqual(${2:1}, ${3:1});$0",
            "}"
        ],
        "description": "test with the leak checking allocator"
    },
    "fuzz": {
        "prefix": "fuzz",
        "body": [
            "test \"${1:fuzz}\" {",
            "    try std.testing.fuzz({}, ${2:fuzzOne}, .{});",
            "}",
            "",
            "fn ${2:fuzzOne}(_: void, smith: *std.testing.Smith) !void {",
            "    var buf: [64]u8 = undefined;",
            "    const input = buf[0..smith.value(u6)];",
            "    smith.bytes(input);",
            "    $0",
            "}"
        ],
        "description": "fuzz test, run with zig build test --fuzz"
    },
    "list": {
        "prefix": "list",
        "body": [
            "var ${1:list}: std.ArrayList(${2:u8}) = .empty;",
            "defer ${1:list}.deinit(gpa);",
            "try ${1:list}.append(gpa, ${3:0});$0"
        ],
        "description": "ArrayList"
    },
    "map": {
        "prefix": "map",
        "body": [
            "var ${1:map}: std.StringHashMapUnmanaged(${2:u32}) = .empty;",
            "defer ${1:map}.deinit(gpa);",
            "try ${1:map}.put(gpa, ${3:\"key\"}, ${4:0});$0"
        ],
        "description": "string hash map"
    },
    "arena": {
        "prefix": "arena",
        "body": [
            "var arena_state: std.heap.ArenaAllocator = .init(gpa);",
            "defer arena_state.deinit();",
            "const arena = arena_state.allocator();$0"
        ],
        "description": "arena on top of gpa"
    },
    "debugalloc": {
        "prefix": "debugalloc",
        "body": [
            "var debug_allocator: std.heap.DebugAllocator(.{}) = .init;",
            "defer _ = debug_allocator.deinit();",
            "const gpa = debug_allocator.allocator();$0"
        ],
        "description": "leak checking gpa when main has no init"
    },
    "readfile": {
        "prefix": "readfile",
        "body": [
            "const ${1:contents} = try std.Io.Dir.cwd().readFileAlloc(io, ${2:\"file.txt\"}, gpa, .limited(${3:1 << 20}));",
            "defer gpa.free(${1:contents});$0"
        ],
        "description": "read a whole file"
    },
    "writefile": {
        "prefix": "writefile",
        "body": [
            "try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = ${1:\"out.txt\"}, .data = ${2:data} });$0"
        ],
        "description": "write a whole file"
    },
    "json": {
        "prefix": "json",
        "body": [
            "const ${1:parsed} = try std.json.parseFromSlice(${2:T}, gpa, ${3:text}, .{});",
            "defer ${1:parsed}.deinit();",
            "const ${4:value} = ${1:parsed}.value;$0"
        ],
        "description": "parse json into a type"
    },
    "async": {
        "prefix": "async",
        "body": [
            "var ${1:future} = io.async(${2:work}, .{${3}});",
            "defer _ = ${1:future}.cancel(io);",
            "const ${4:result} = ${1:future}.await(io);$0"
        ],
        "description": "run a function on io and wait for it"
    },
    "group": {
        "prefix": "group",
        "body": [
            "var group: std.Io.Group = .init;",
            "defer group.cancel(io);",
            "for (${1:items}) |${2:item}| group.async(io, ${3:visit}, .{${2:item}});",
            "try group.await(io);$0"
        ],
        "description": "run a function per item on io and wait for all"
    },
    "sleep": {
        "prefix": "sleep",
        "body": [
            "try io.sleep(.fromMilliseconds(${1:100}), .awake);$0"
        ],
        "description": "sleep"
    },
    "timer": {
        "prefix": "timer",
        "body": [
            "const ${1:start} = std.Io.Clock.awake.now(io);",
            "$0",
            "std.log.info(\"${2:took} {d} ms\", .{${1:start}.untilNow(io, .awake).toMilliseconds()});"
        ],
        "description": "time a block"
    },
    "fields": {
        "prefix": "fields",
        "body": [
            "inline for (comptime std.meta.fieldNames(@TypeOf(${1:value}))) |name| {",
            "    std.log.info(\"{s} = {any}\", .{ name, @field(${1:value}, name) });$0",
            "}"
        ],
        "description": "loop over a struct's fields"
    },
    "log": {
        "prefix": "log",
        "body": [
            "const log = std.log.scoped(.${1:name});$0"
        ],
        "description": "scoped logger"
    },
    "script": {
        "prefix": "script",
        "body": [
            "//usr/bin/env sh -c \"\\$(sed -n 's|^//> \\{0,1\\\\\\}||p' \"\\$0\")\" \"\\$0\" \"\\$@\"; exit",
            "//> # runs the //> lines as sh: inside nix-shell when there is one, else",
            "//> # with the tools already on PATH",
            "//> set -e",
            "//> if [ -z \"\\$SCRIPT_DEPS\" ] && command -v nix-shell >/dev/null; then",
            "//>     exec nix-shell -p ${1:zig_0_17} --run \"SCRIPT_DEPS=1 sh '\\$0' \\$*\"",
            "//> fi",
            "//> c=\\${XDG_CACHE_HOME:-\\$HOME/.cache}/${2:name}",
            "//> mkdir -p \"\\$c\"",
            "//> export ZIG_LOCAL_CACHE_DIR=\"\\$c/zig\"",
            "//> exec zig run -freference-trace=10 -j\"\\$(nproc)\" \"\\$0\" -- \"\\$@\"",
            "const std = @import(\"std\");",
            "",
            "pub fn main() void {",
            "    $0",
            "}"
        ],
        "description": "zig script: sh runs it with zig run, deps from nix-shell -p"
    },
    "scriptc": {
        "prefix": "scriptc",
        "body": [
            "//usr/bin/env sh -c \"\\$(sed -n 's|^//> \\{0,1\\\\\\}||p' \"\\$0\")\" \"\\$0\" \"\\$@\"; exit",
            "//> # runs the //> lines as sh: inside nix-shell when there is one, else",
            "//> # with the tools already on PATH",
            "//> set -e",
            "//> if [ -z \"\\$SCRIPT_DEPS\" ] && command -v nix-shell >/dev/null; then",
            "//>     exec nix-shell -p ${1:zig_0_17 pkg-config glfw libGL} --run \"SCRIPT_DEPS=1 sh '\\$0' \\$*\"",
            "//> fi",
            "//> c=\\${XDG_CACHE_HOME:-\\$HOME/.cache}/${2:name}",
            "//> mkdir -p \"\\$c\"",
            "//> export ZIG_LOCAL_CACHE_DIR=\"\\$c/zig\"",
            "//> # zig 0.17 has no @cImport, the c headers become zig modules here",
            "//> h=${3:\\$(pkg-config --variable=includedir glfw3)/GLFW/glfw3.h}",
            "//> zig translate-c -lc \\$(pkg-config --cflags ${4:glfw3 gl}) \"\\$h\" > \"\\$c/c.zig\"",
            "//> exec zig run -freference-trace=10 -j\"\\$(nproc)\" -lc \\$(pkg-config --libs ${4}) --dep c -Mroot=\"\\$0\" -Mc=\"\\$c/c.zig\" -- \"\\$@\"",
            "const std = @import(\"std\");",
            "const c = @import(\"c\");",
            "",
            "pub fn main() void {",
            "    $0",
            "}"
        ],
        "description": "zig script with c headers through translate-c, libs from pkg-config"
    }
}
