{
    "fetch": {
        "prefix": "fetch",
        "body": [
            "var body: std.Io.Writer.Allocating = .init(gpa);",
            "defer body.deinit();",
            "const fetch_res = try client.fetch(.{",
            "    .location = .{ .url = url },",
            "    .method = .GET,",
            "    .response_writer = &body.writer,",
            "});",
            "if (fetch_res.status != .ok) {",
            "    return error.ReqFail;",
            "}",
            "const res_body = try body.toOwnedSlice();"
        ],
        "description": "fetch"
    },
    "translate c": {
        "prefix": "translate",
        "body": [
            "const somelib = b.addTranslateC(.{",
            ".root_source_file = blk: {",
            "const wf = b.addWriteFiles();",
            "const wf_path = wf.add(\"c_somelib.h\",",
            "// c",
            "\\\\\\\\#include \"somelib_c.h\"",
            ");",
            "break :blk wf_path;",
            "},",
            ".optimize = optimize,",
            ".target = target,",
            "});",
            "exe_mod.linkSystemLibrary(\"somelib\", .{});"
        ],
        "description": "translate c"
    },
    "run": {
        "prefix": "std.process.run",
        "body": [
            "const run_result = try std.process.run(gpa, io, .{ .argv = &.{} });",
            "defer gpa.free(run_result.stderr);",
            "defer gpa.free(run_result.stdout);",
            "if (run_result.term != .exited) return error.Failed;"
        ],
        "description": "run a process and free"
    },
    "io": {
        "prefix": "io",
        "body": [
            "var threaded: std.Io.Threaded = .init_single_threaded;",
            "const io = threaded.io();"
        ],
        "description": "get an io"
    },
    "rand": {
        "prefix": "rand",
        "body": [
            "var seed: u64 = undefined;",
            "io.random(std.mem.asBytes(&seed));",
            "var prng: std.Random.DefaultPrng = .init(seed);",
            "const rand = prng.random();"
        ],
        "description": "get a rand"
    },
    "stdin": {
        "prefix": "stdin",
        "description": "stdin",
        "body": [
            "var stdin_buffer: [1024]u8 = undefined;",
            "var stdin_reader = std.Io.File.stdin().reader(init.io, &stdin_buffer);",
            "const stdin = &stdin_reader.interface;"
        ]
    },
    "stdout": {
        "prefix": "stdout",
        "description": "stdout",
        "body": [
            "var stdout_buffer: [1024]u8 = undefined;",
            "var stdout_writer = std.Io.File.stdout().writer(init.io, &stdout_buffer);",
            "const stdout = &stdout_writer.interface;",
            "defer stdout.flush() catch {};"
        ]
    },
    "panic": {
        "prefix": "panic",
        "description": "zig custom panic",
        "body": [
            "pub const panic = std.debug.FullPanic(struct {",
            "    extern \"c\" fn system(command: [*:0]const u8) c_int;",
            "",
            "    fn crashed(msg: []const u8, first_trace_addr: ?usize) noreturn {",
            "        var buf: [4096]u8 = undefined;",
            "        if (std.fmt.bufPrintSentinel(&buf, \"zenity --error --text '{s}'\", .{msg}, 0)) |cmd| {",
            "            _ = system(cmd.ptr);",
            "        } else |_| {}",
            "        std.debug.defaultPanic(msg, first_trace_addr);",
            "    }",
            "}.crashed);"
        ]
    }
}
