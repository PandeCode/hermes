{
    "graphviz fence": {
        "prefix": "graphviz",
        "body": [
            "```graphviz",
            "digraph {",
            "\t${1:a} -> ${2:b}$0",
            "}",
            "```"
        ],
        "description": "graphviz block, K shows it"
    },
    "wavedrom fence": {
        "prefix": "wavedrom",
        "body": [
            "```wavedrom",
            "{ signal: [",
            "\t{ name: \"${1:clk}\", wave: \"${2:p......}\" },$0",
            "] }",
            "```"
        ],
        "description": "wavedrom timing diagram, K shows it"
    },
    "svgbob fence": {
        "prefix": "svgbob",
        "body": [
            "```svgbob",
            "${1:a} ---> ${2:b}$0",
            "```"
        ],
        "description": "svgbob ascii drawing, K shows it"
    },
    "d2 fence": {
        "prefix": "d2",
        "body": [
            "```d2",
            "${1:a} -> ${2:b}$0",
            "```"
        ],
        "description": "d2 diagram, K shows it"
    }
