{
    "graph": {
        "prefix": "digraph",
        "description": "digraph",
        "body": [
            "#raw-render(",
            "  ```dot",
            "  digraph {",
            "    // splines=ortho",
            "    // overlap=false",
            "    rankdir=LR",
            "    fontname=\"Helvetica,Arial,sans-serif\"",
            "    node [fontname=\"Helvetica,Arial,sans-serif\"]",
            "    edge [fontname=\"Helvetica,Arial,sans-serif\"]",
            "",
            "    subgraph c2 {",
            "      style=filled;",
            "      color=lightgrey;",
            "      node[label = \"p*\"] p;",
            "      node[label=\"0\"] n0;",
            "      node[label=\"...\"] ne;",
            "",
            "      p -> p [shape=doublecircle,label=\"p\"];",
            "      m -> m [label=\"p, q\"];",
            "    }",
            "",
            "    subgraph c1 {",
            "      node[] a;",
            "      node[] b;",
            "      node[] c;",
            "",
            "      a -> a [label=\"p\"];",
            "      b -> b [label = \"q\"];",
            "      a -> b [label=\"q\"];",
            "      b -> c [label=\"p\"];",
            "      c -> c [label=\"pq\"];",
            "    }",
            "",
            "    a -> p",
            "    b -> m",
            "  }",
            "",
            "  ```,",
            ")"
        ]
    },
    "graphviz fence": {
        "prefix": "graphviz",
        "body": [
            "```graphviz",
            "digraph {",
            "\t${1:a} -> ${2:b}$0",
            "}",
            "```"
        ],
        "description": "graphviz block, K shows it"
    },
    "wavedrom fence": {
        "prefix": "wavedrom",
        "body": [
            "```wavedrom",
            "{ signal: [",
            "\t{ name: \"${1:clk}\", wave: \"${2:p......}\" },$0",
            "] }",
            "```"
        ],
        "description": "wavedrom timing diagram, K shows it"
    }
}
